{
  "version": 1,
  "storeDir": ".kakurizai/store",
  "defaultBackend": "cube-sandbox-overlay",
  "studio": {
    "host": "127.0.0.1",
    "port": 38476,
    "publicUrl": null,
    "secureCookies": false,
    "trustProxy": false,
    "trustedProxies": [],
    "allowedHosts": [],
    "trustedOrigins": [],
    "ipAllowlist": [],
    "ipDenylist": [],
    "rateLimit": {
      "enabled": true,
      "windowSeconds": 60,
      "maxRequests": 600
    },
    "tls": {
      "certFile": null,
      "keyFile": null
    }
  },
  "auth": {
    "provider": "keycloak",
    "serverUrl": "http://127.0.0.1:8080",
    "realm": "kakurizai",
    "clientId": "kakurizai-studio",
    "clientSecret": null,
    "audience": "kakurizai-studio",
    "scopes": [
      "openid",
      "profile",
      "email"
    ],
    "sessionTtlSeconds": 28800,
    "maxLoginAttempts": 12,
    "persistSessions": true,
    "sessionFile": ".kakurizai/auth/studio-sessions.json",
    "rbac": {
      "enabled": true,
      "defaultRole": null,
      "users": {},
      "roles": {}
    },
    "mfa": {
      "required": true
    }
  },
  "audit": {
    "enabled": true,
    "logReads": false,
    "file": ".kakurizai/audit/studio.jsonl",
    "chain": true
  },
  "security": {
    "enforceRemoteAccess": true,
    "allowInsecureRemote": false
  },
  "observability": {
    "retentionSamples": 288,
    "traceEvents": 2000,
    "tracing": true
  },
  "cube": {
    "mode": "auto",
    "cubecli": "cubecli",
    "mastercli": "cubemastercli",
    "apiBaseUrl": null,
    "apiTimeoutMs": 120000,
    "template": "kakurizai-base",
    "namespace": "kakurizai",
    "cpu": "2000m",
    "memory": "2000Mi",
    "workspacePath": "/workspace"
  },
  "gvisor": {
    "docker": "docker",
    "dockerHost": null,
    "runtime": "runsc",
    "image": "ubuntu:24.04",
    "workspacePath": "/workspace",
    "dockerNetwork": "bridge",
    "mountMode": "agctl-overlay",
    "cpu": "1000m",
    "memory": "1024Mi",
    "pull": "missing"
  },
  "fuchsia": {
    "ffx": "ffx",
    "isolateDir": ".kakurizai/fuchsia/ffx",
    "productBundle": null,
    "acceleration": "auto",
    "engine": null,
    "network": "user",
    "cpu": "2",
    "startupTimeoutSeconds": 180,
    "repositoryEnabled": true,
    "repositoryAddress": "[::]:0",
    "disableAnalytics": true
  },
  "isolatedAgent": {
    "agentctl": "agentctl",
    "sourceTree": "vendor/IPA-RS-IsolatedAgent"
  }
}
