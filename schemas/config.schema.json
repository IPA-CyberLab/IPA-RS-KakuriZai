{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KakuriZai Config",
  "type": "object",
  "properties": {
    "version": { "const": 1 },
    "home": { "type": "string" },
    "storeDir": { "type": "string" },
    "defaultBackend": {
      "enum": [
        "apfs-clone",
        "windows-block-clone",
        "linux-native",
        "systemd-nspawn",
        "btrfs",
        "path-preserving-overlay",
        "windows-minifilter-overlay",
        "cube-sandbox-overlay",
        "gvisor",
        "fuchsia"
      ]
    },
    "studio": {
      "type": "object",
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "publicUrl": { "type": ["string", "null"] },
        "secureCookies": { "type": "boolean" },
        "trustProxy": { "type": "boolean" },
        "trustedProxies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "allowedHosts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "trustedOrigins": {
          "type": "array",
          "items": { "type": "string" }
        },
        "ipAllowlist": {
          "type": "array",
          "items": { "type": "string" }
        },
        "ipDenylist": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rateLimit": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "windowSeconds": { "type": "integer", "minimum": 1 },
            "maxRequests": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "tls": {
          "type": "object",
          "properties": {
            "certFile": { "type": ["string", "null"] },
            "keyFile": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "auth": {
      "oneOf": [
        {
          "type": "object",
          "required": ["provider"],
          "properties": {
            "provider": { "const": "none" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["provider", "realm", "clientId"],
          "properties": {
            "provider": { "const": "keycloak" },
            "serverUrl": { "type": "string" },
            "realm": { "type": "string" },
            "issuer": { "type": "string" },
            "discoveryUrl": { "type": "string" },
            "clientId": { "type": "string" },
            "clientSecret": { "type": ["string", "null"] },
            "audience": { "type": "string" },
            "jwksUri": { "type": "string" },
            "scopes": {
              "oneOf": [
                { "type": "string" },
                { "type": "array", "items": { "type": "string" } }
              ]
            },
            "authorizationParams": {
              "type": "object",
              "additionalProperties": {
                "type": ["string", "number", "boolean"]
              }
            },
            "sessionTtlSeconds": { "type": "integer", "minimum": 60 },
            "maxLoginAttempts": { "type": "integer", "minimum": 1 },
            "persistSessions": { "type": "boolean" },
            "sessionFile": { "type": "string" },
            "rbac": { "type": "object", "additionalProperties": true },
            "mfa": { "type": "object", "additionalProperties": true }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["provider", "issuer", "clientId"],
          "properties": {
            "provider": { "const": "oidc" },
            "label": { "type": "string" },
            "issuer": { "type": "string" },
            "discoveryUrl": { "type": "string" },
            "clientId": { "type": "string" },
            "clientSecret": { "type": ["string", "null"] },
            "audience": { "type": "string" },
            "jwksUri": { "type": "string" },
            "scopes": {
              "oneOf": [
                { "type": "string" },
                { "type": "array", "items": { "type": "string" } }
              ]
            },
            "authorizationParams": {
              "type": "object",
              "additionalProperties": {
                "type": ["string", "number", "boolean"]
              }
            },
            "sessionTtlSeconds": { "type": "integer", "minimum": 60 },
            "maxLoginAttempts": { "type": "integer", "minimum": 1 },
            "persistSessions": { "type": "boolean" },
            "sessionFile": { "type": "string" },
            "rbac": { "type": "object", "additionalProperties": true },
            "mfa": { "type": "object", "additionalProperties": true }
          },
          "additionalProperties": false
        }
      ]
    },
    "audit": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "logReads": { "type": "boolean" },
        "file": { "type": "string" },
        "chain": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "properties": {
        "enforceRemoteAccess": { "type": "boolean" },
        "allowInsecureRemote": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "observability": {
      "type": "object",
      "properties": {
        "retentionSamples": { "type": "integer", "minimum": 1 },
        "traceEvents": { "type": "integer", "minimum": 1 },
        "tracing": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "cube": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["auto", "master", "cli", "api", "disabled"] },
        "cubecli": { "type": "string" },
        "mastercli": { "type": "string" },
        "apiBaseUrl": { "type": ["string", "null"] },
        "apiTimeoutMs": { "type": "integer", "minimum": 1000 },
        "apiKey": { "type": ["string", "null"], "minLength": 32 },
        "apiKeyFile": { "type": "string" },
        "template": { "type": "string" },
        "namespace": { "type": "string" },
        "cpu": { "type": "string" },
        "memory": { "type": "string" },
        "workspacePath": { "type": "string" }
      },
      "additionalProperties": true
    },
    "gvisor": {
      "type": "object",
      "properties": {
        "docker": { "type": "string" },
        "dockerHost": { "type": ["string", "null"] },
        "runtime": { "type": "string" },
        "image": { "type": "string" },
        "workspacePath": { "type": "string" },
        "dockerNetwork": { "type": ["string", "null"] },
        "mountMode": { "enum": ["agctl-overlay", "cubesandbox-readonly", "unsafe-rw", "none"] },
        "cpu": { "type": "string" },
        "memory": { "type": "string" },
        "pull": { "enum": ["always", "missing", "never"] },
        "createTimeoutMs": { "type": "integer", "minimum": 1000 },
        "iptables": { "type": "string" },
        "firewallReconcileMs": { "type": "integer", "minimum": 1000 },
        "protectedCidrs": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "fuchsia": {
      "type": "object",
      "properties": {
        "ffx": { "type": "string" },
        "isolateDir": { "type": "string" },
        "productBundle": { "type": ["string", "null"] },
        "acceleration": { "enum": ["auto", "hyper", "none"] },
        "engine": { "enum": ["femu", "qemu", null] },
        "network": { "enum": ["auto", "user", "tap", "none"] },
        "cpu": { "type": ["string", "integer"] },
        "startupTimeoutSeconds": { "type": "integer", "minimum": 1 },
        "targetTimeoutMs": { "type": "integer", "minimum": 1000 },
        "repositoryEnabled": { "type": "boolean" },
        "repositoryAddress": { "type": "string" },
        "disableAnalytics": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "isolatedAgent": {
      "type": "object",
      "properties": {
        "agentctl": { "type": "string" },
        "sourceTree": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
